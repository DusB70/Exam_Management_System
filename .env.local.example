# ============================================================
# EMS — Environment Template
# ============================================================
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and should never be committed.
# ============================================================

# ----- Backend (NestJS) -------------------------------------

PORT=4000

# Supabase PostgreSQL connection (via PgBouncer for pooling)
# Format: postgresql://[user]:[password]@[host]:[port]/[db]?pgbouncer=true
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/postgres?pgbouncer=true"


# JWT tokens — CHANGE THESE in production!
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS & Rate limiting
CORS_ORIGIN="http://localhost:3000"
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# ----- Frontend (Next.js) -----------------------------------

NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY_HERE
