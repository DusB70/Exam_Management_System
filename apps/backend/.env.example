# Server Port
PORT=4000

# Database Configuration (PostgreSQL)
# Adjust with your local PostgreSQL credentials:
# Format: postgresql://[user]:[password]@[host]:[port]/[database_name]?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ems?schema=public"

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Secrets (Make sure to replace these in production)
JWT_ACCESS_SECRET="super-secret-access-token-key-change-in-production"
JWT_REFRESH_SECRET="super-secret-refresh-token-key-change-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Security Configurations
CORS_ORIGIN="http://localhost:3000"
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100
