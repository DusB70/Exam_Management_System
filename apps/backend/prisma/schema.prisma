generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Role {
  role_id    Int       @id @default(autoincrement())
  role_name  String    @unique @db.VarChar(50)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  users      User[]

  @@map("roles")
}

model User {
  user_id            Int            @id @default(autoincrement())
  full_name          String         @db.VarChar(150)
  name_with_initials String         @db.VarChar(100)
  email              String         @unique @db.VarChar(150)
  password_hash      String
  role_id            Int
  is_active          Boolean?       @default(true)
  nic_no             String         @unique @db.VarChar(20)
  date_of_birth      DateTime       @db.Date
  phone_number       String         @db.VarChar(20)
  address            String         @db.VarChar(255)
  created_at         DateTime?      @default(now()) @db.Timestamp(6)
  audit_logs         AuditLog[]
  recorded_marks     ExamMark[]
  lecturer           Lecturer?
  refresh_tokens     RefreshToken[]
  student            Student?
  role               Role           @relation(fields: [role_id], references: [role_id], onUpdate: NoAction)

  @@map("users")
}

model Department {
  department_id        Int              @id @default(autoincrement())
  department_name      String           @unique @db.VarChar(100)
  department_code      String           @unique @db.VarChar(20)
  parent_department_id Int?
  created_at           DateTime?        @default(now()) @db.Timestamp(6)
  parent_department    Department?      @relation("DepartmentHierarchy", fields: [parent_department_id], references: [department_id], onDelete: Restrict, onUpdate: NoAction)
  child_departments    Department[]     @relation("DepartmentHierarchy")
  courses              Course[]
  lecturers            Lecturer[]
  degrees              Degree[]
  specializations      Specialization[]

  @@map("departments")
}

model Student {
  student_id          Int                  @id @default(autoincrement())
  user_id             Int                  @unique
  registration_number String               @unique @db.VarChar(50)
  index_number        String               @unique @db.VarChar(50)
  degree_id           Int
  specialization_id   Int?
  academic_year       Int
  registrations       CourseRegistration[]
  exam_marks          ExamMark[]
  course_grades       StudentCourseGrade[]
  semester_gpas       StudentSemesterGpa[]
  degree              Degree               @relation(fields: [degree_id], references: [degree_id])
  specialization      Specialization?      @relation(fields: [specialization_id], references: [specialization_id])
  user                User                 @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  medical_submissions     MedicalSubmission[]
  grace_chance_applications GraceChanceApplication[]
  recorrection_requests   RecorrectionRequest[]

  @@map("students")
}

model Lecturer {
  lecturer_id     Int              @id @default(autoincrement())
  user_id         Int              @unique
  employee_number String           @unique @db.VarChar(50)
  department_id   Int
  specialization  String?          @db.VarChar(100)
  is_head         Boolean          @default(false)
  is_dean         Boolean          @default(false)
  courses         CourseLecturer[]
  department      Department       @relation(fields: [department_id], references: [department_id])
  user            User             @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("lecturers")
}

model Degree {
  degree_id       Int              @id @default(autoincrement())
  degree_name     String           @unique @db.VarChar(150)
  degree_code     String           @unique @db.VarChar(20)
  department_id   Int
  department      Department       @relation(fields: [department_id], references: [department_id], onDelete: Cascade)
  students        Student[]
  specializations Specialization[]
  courses         CourseDegree[]

  @@map("degrees")
}

model Specialization {
  specialization_id   Int         @id @default(autoincrement())
  specialization_name String      @db.VarChar(150)
  specialization_code String      @db.VarChar(20)
  degree_id           Int
  department_id       Int?
  degree              Degree      @relation(fields: [degree_id], references: [degree_id], onDelete: Cascade)
  department          Department? @relation(fields: [department_id], references: [department_id], onDelete: SetNull, onUpdate: NoAction)
  students            Student[]
  courses             Course[]

  @@unique([degree_id, specialization_code])
  @@map("specializations")
}

model Course {
  course_id         Int                  @id @default(autoincrement())
  course_code       String               @unique @db.VarChar(20)
  course_name       String               @db.VarChar(150)
  credit_value      Decimal              @db.Decimal(3, 1)
  department_id     Int
  specialization_id Int?
  semester          String               @db.VarChar(10)
  created_at        DateTime?            @default(now()) @db.Timestamp(6)
  lecturers         CourseLecturer[]
  registrations     CourseRegistration[]
  degrees           CourseDegree[]
  department        Department           @relation(fields: [department_id], references: [department_id])
  specialization    Specialization?      @relation(fields: [specialization_id], references: [specialization_id])
  exams             Exam[]
  course_grades     StudentCourseGrade[]
  marks_config             Json?
  result_submission_status String?              @db.VarChar(20)
  rejection_reason         String?              @db.Text
  ca_published             Boolean              @default(false)

  @@map("courses")
}

model CourseRegistration {
  registration_id   Int       @id @default(autoincrement())
  student_id        Int
  course_id         Int
  registration_date DateTime? @default(now()) @db.Timestamp(6)
  course            Course    @relation(fields: [course_id], references: [course_id], onDelete: Cascade)
  student           Student   @relation(fields: [student_id], references: [student_id], onDelete: Cascade)

  @@unique([student_id, course_id], name: "unique_student_course")
  @@map("course_registrations")
}

model Exam {
  exam_id     Int            @id @default(autoincrement())
  course_id   Int
  exam_type   String         @db.VarChar(50)
  exam_title  String         @db.VarChar(150)
  total_marks Int
  exam_date   DateTime       @db.Date
  start_time  DateTime       @db.Time(6)
  end_time    DateTime       @db.Time(6)
  exam_marks  ExamMark[]
  schedules   ExamSchedule[]
  course      Course         @relation(fields: [course_id], references: [course_id], onDelete: Cascade)

  @@map("exams")
}

model ExamHall {
  hall_id   Int            @id @default(autoincrement())
  hall_name String         @unique @db.VarChar(50)
  capacity  Int
  schedules ExamSchedule[]

  @@map("exam_halls")
}

model ExamSchedule {
  schedule_id Int      @id @default(autoincrement())
  exam_id     Int
  hall_id     Int
  exam        Exam     @relation(fields: [exam_id], references: [exam_id], onDelete: Cascade)
  hall        ExamHall @relation(fields: [hall_id], references: [hall_id])

  @@map("exam_schedules")
}

model RefreshToken {
  token_id   String   @id @default(uuid()) @db.Uuid
  user_id    Int
  token      String   @unique
  expires_at DateTime @db.Timestamp(6)
  is_revoked Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamp(6)
  user       User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model CourseLecturer {
  course_id   Int
  lecturer_id Int
  assigned_at DateTime @default(now()) @db.Timestamp(6)
  course      Course   @relation(fields: [course_id], references: [course_id], onDelete: Cascade)
  lecturer    Lecturer @relation(fields: [lecturer_id], references: [lecturer_id], onDelete: Cascade)

  @@id([course_id, lecturer_id])
  @@map("course_lecturers")
}

model RegistrationPeriod {
  period_id     Int      @id @default(autoincrement())
  academic_year Int
  semester      String   @db.VarChar(10)
  start_date    DateTime @db.Timestamp(6)
  end_date      DateTime @db.Timestamp(6)
  status        String   @default("CLOSED") @db.VarChar(20)
  created_at    DateTime @default(now()) @db.Timestamp(6)
  updated_at    DateTime @updatedAt @db.Timestamp(6)

  @@map("registration_periods")
}

model ExamMark {
  mark_id        Int      @id @default(autoincrement())
  student_id     Int
  exam_id        Int
  marks_obtained Float
  recorded_by_id Int
  grading_status String   @default("PENDING") @db.VarChar(20)
  created_at     DateTime @default(now()) @db.Timestamp(6)
  updated_at     DateTime @updatedAt @db.Timestamp(6)
  exam           Exam     @relation(fields: [exam_id], references: [exam_id], onDelete: Cascade)
  recorded_by    User     @relation(fields: [recorded_by_id], references: [user_id])
  student        Student  @relation(fields: [student_id], references: [student_id], onDelete: Cascade)

  @@unique([student_id, exam_id])
  @@map("exam_marks")
}

model StudentCourseGrade {
  grade_id                    Int      @id @default(autoincrement())
  student_id                  Int
  course_id                   Int
  continuous_assessment_marks Float    @default(0)
  final_exam_marks            Float    @default(0)
  total_marks                 Float    @default(0)
  grade                       String   @db.VarChar(15)
  grade_point                 Float
  is_published                Boolean  @default(false)
  is_locked                   Boolean  @default(false)
  result_status               String?  @db.VarChar(20)
  created_at                  DateTime @default(now()) @db.Timestamp(6)
  updated_at                  DateTime @updatedAt @db.Timestamp(6)
  course                      Course   @relation(fields: [course_id], references: [course_id], onDelete: Cascade)
  student                     Student  @relation(fields: [student_id], references: [student_id], onDelete: Cascade)

  @@unique([student_id, course_id])
  @@map("student_course_grades")
}

model StudentSemesterGpa {
  gpa_id         Int      @id @default(autoincrement())
  student_id     Int
  academic_year  Int
  semester       String   @db.VarChar(10)
  semester_gpa   Float
  cumulative_gpa Float
  total_credits  Float
  is_published   Boolean  @default(false)
  is_locked      Boolean  @default(false)
  created_at     DateTime @default(now()) @db.Timestamp(6)
  updated_at     DateTime @updatedAt @db.Timestamp(6)
  student        Student  @relation(fields: [student_id], references: [student_id], onDelete: Cascade)

  @@unique([student_id, academic_year, semester])
  @@map("student_semester_gpas")
}

model AuditLog {
  log_id      Int      @id @default(autoincrement())
  user_id     Int?
  action      String   @db.VarChar(50)
  entity_name String   @db.VarChar(50)
  entity_id   String   @db.VarChar(50)
  old_values  Json?
  new_values  Json?
  ip_address  String?  @db.VarChar(45)
  user_agent  String?  @db.VarChar(255)
  created_at  DateTime @default(now()) @db.Timestamp(6)
  user        User?    @relation(fields: [user_id], references: [user_id])

  @@map("audit_logs")
}

model MedicalSubmission {
  medical_id               Int      @id @default(autoincrement())
  student_id               Int
  exam_name                String   @db.VarChar(150)
  subjects                 Json     // Array of: { date: string, course_code: string, title: string }
  medical_certificate_url  String   @db.VarChar(255)
  request_letter_url       String?  @db.VarChar(255)
  status                   String   @default("PENDING") @db.VarChar(20) // PENDING, APPROVED, REJECTED
  created_at               DateTime @default(now()) @db.Timestamp(6)
  updated_at               DateTime @updatedAt @db.Timestamp(6)
  student                  Student  @relation(fields: [student_id], references: [student_id], onDelete: Cascade)

  @@map("medical_submissions")
}

model GraceChanceApplication {
  grace_id                 Int      @id @default(autoincrement())
  student_id               Int
  date_of_registration     DateTime @db.Date
  address                  String   @db.VarChar(255)
  phone                    String   @db.VarChar(20)
  faculty                  String   @db.VarChar(100)
  total_credits            Float
  internship_credits       Float
  research_credits         Float
  industrial_credits       Float
  course_credits           Float
  incomplete_subjects      Json     // Array of: { code: string, title: string, attempts: { first: { year: string, semester: string }, second: { year: string, semester: string }, third: { year: string, semester: string } }, credits: number }
  total_incomplete_credits Float
  credit_percentage        Float
  status                   String   @default("PENDING") @db.VarChar(20) // PENDING, APPROVED, REJECTED
  declaration_signed       Boolean  @default(false)
  created_at               DateTime @default(now()) @db.Timestamp(6)
  updated_at               DateTime @updatedAt @db.Timestamp(6)
  student                  Student  @relation(fields: [student_id], references: [student_id], onDelete: Cascade)

  @@map("grace_chance_applications")
}

model RecorrectionRequest {
  recorrection_id          Int      @id @default(autoincrement())
  student_id               Int
  exam_name                String   @db.VarChar(150)
  academic_year            Int
  semester                 String   @db.VarChar(10)
  subjects                 Json     // Array of: { exam_type: string, course_code: string, course_name: string, marks_received: number, grade_received: string }
  total_amount_paid        Float
  receipt_url              String   @db.VarChar(255)
  status                   String   @default("PENDING") @db.VarChar(20) // PENDING, APPROVED, REJECTED
  created_at               DateTime @default(now()) @db.Timestamp(6)
  updated_at               DateTime @updatedAt @db.Timestamp(6)
  student                  Student  @relation(fields: [student_id], references: [student_id], onDelete: Cascade)

  @@map("recorrection_requests")
}

model CourseDegree {
  course_id   Int
  degree_id   Int
  status      String   @db.VarChar(20) // "COMPULSORY" or "OPTIONAL"
  course      Course   @relation(fields: [course_id], references: [course_id], onDelete: Cascade)
  degree      Degree   @relation(fields: [degree_id], references: [degree_id], onDelete: Cascade)

  @@id([course_id, degree_id])
  @@map("course_degrees")
}
